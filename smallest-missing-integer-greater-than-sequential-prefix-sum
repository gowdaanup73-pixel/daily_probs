class Solution:
    def missingInteger(self, nums: List[int]) -> int:
        def helper(nums):
            n = len(nums)
            i = 0
            while i + 1 < n and nums[i+1] == nums[i] + 1:
                i += 1
            s = sum(nums[:i+1])
            st = set(nums)
            while s in st:
                s += 1
            return s
        return helper(nums)
